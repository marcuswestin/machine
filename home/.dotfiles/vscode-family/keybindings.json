[
  // Shift+movement enters Visual via vim.remap (Normal: v+motion; Visual: extend with the
  // same motion). Bare arrows in Visual and j/k/up/down in settings use gj/gk so wrapped
  // lines stay inside VSCodeVim. alt+shift+* stays on VS Code commands for search/multi-cursor.
  {
    "key": "alt+shift+down",
    "command": "editor.action.insertCursorBelow",
    "when": "editorTextFocus"
  },
  {
    "key": "alt+shift+up",
    "command": "editor.action.insertCursorAbove",
    "when": "editorTextFocus"
  },
  {
    "key": "alt+shift+j",
    "command": "search.action.focusNextSearchResult",
    "when": "hasSearchResult || inSearchEditor"
  },
  {
    "key": "alt+shift+k",
    "command": "search.action.focusPreviousSearchResult",
    "when": "hasSearchResult || inSearchEditor"
  },
